# Python
__pycache__/
*.pyc

# Generated circuit artifacts (reproducible via create-sha256-base.py / optimize-graph.py)
*.nodes
*.nodes.mutated
*.check.nodes
*.pin

# Layout binaries: the deployed copy lives in docs/ (tracked); root-level build artifacts are ignored
/*.glayout

# Claude session breadcrumb (machine/session-specific; read by the pre-commit hook)
.claude-session-path

# Marginalia plumbing (session.jsonl itself IS tracked, added by the pre-commit hook)
claude/JSONL/marginalia-debug.log
